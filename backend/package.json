{
  "name": "financial-os-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Financial OS backend — Fastify + TypeScript + PostgreSQL + Redis",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": "20.x"
  }
}
