# Backend auto-loads ../infra/.env if present (Infra Docker).
# Override with ENV_FILE if running from a different layout.

# Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Optional override for .env file location
# ENV_FILE=../infra/.env
