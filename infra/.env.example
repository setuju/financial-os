# --- PostgreSQL (Docker: host 5433 -> container 5432) ---
POSTGRES_USER=financial_os
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=financial_os

# --- Redis (Docker: host 6380 -> container 6379) ---
REDIS_PASSWORD=change_me_dev_only

# --- Backend connection strings ---
DATABASE_URL=postgres://financial_os:change_me_dev_only@localhost:5433/financial_os
REDIS_URL=redis://:change_me_dev_only@localhost:6380

# --- PayPal Sandbox (isi manual dari developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Elastic (Minggu 2) ---
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=
CHANNEL3_API_KEY=your_channel3_api_key
